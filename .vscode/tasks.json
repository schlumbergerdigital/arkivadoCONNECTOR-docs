{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zensical: serve",
      "type": "shell",
      "command": "python",
      "args": ["-m", "zensical", "serve"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "zensical",
        "pattern": {
          "regexp": "^Error: (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving ",
          "endsPattern": "on http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Zensical: build",
      "type": "shell",
      "command": "python",
      "args": ["-m", "zensical", "build"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Doku: Vorschau im Editor",
      "type": "shell",
      "command": "echo ${input:openSimpleBrowser}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "close": true
      }
    },
    {
      "label": "Zensical: serve + Vorschau",
      "dependsOrder": "sequence",
      "dependsOn": ["Zensical: serve", "Doku: Vorschau im Editor"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://localhost:8000/"
    }
  ]
}
